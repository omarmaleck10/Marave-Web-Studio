{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/servicios/", "destination": "/servicios.html" },
    { "source": "/nosotros/", "destination": "/nosotros.html" },
    { "source": "/proyectos/", "destination": "/proyectos.html" },
    { "source": "/presupuesto/", "destination": "/presupuesto.html" },
    { "source": "/contacto/", "destination": "/contacto.html" },
    { "source": "/blog/", "destination": "/blog.html" },
    { "source": "/blog/:slug/", "destination": "/articulo.html" },
    { "source": "/blog/:slug", "destination": "/articulo.html" },
    { "source": "/articulo/", "destination": "/articulo.html" },
    { "source": "/aviso-legal/", "destination": "/aviso-legal.html" },
    { "source": "/privacidad/", "destination": "/privacidad.html" },
    { "source": "/cookies/", "destination": "/cookies.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/main.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/wp-api.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*\\.png|.*\\.jpg|.*\\.ico|.*\\.svg|.*\\.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
